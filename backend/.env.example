# ==============================================================================
# FleetFlow Backend Environment Variables (Production & Local Template)
# NOTE: Never commit sensitive credentials to version control.
# ==============================================================================

# Database Connection (PostgreSQL)
# Local Example: postgresql://postgres:password@localhost:5432/fleetflow
# Production Example (Render): Auto-injected or provided by Render Managed PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/fleetflow

# Security & Authentication
# Generate a secure 32+ byte string in production: openssl rand -hex 32
SECRET_KEY=your-production-secret-key-change-this-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Administrator Registration Protection Key
# Required when creating an account with role "Admin" via /auth/signup
ADMIN_SECRET_KEY=FLEETFLOW_ADMIN_2026

# Environment & Seeding Mode ("development" | "production")
# When set to "production" and SEED_DEMO_DATA=false, default mock data is not seeded.
ENVIRONMENT=production
SEED_DEMO_DATA=false

# CORS Allowed Origins
# Comma-separated list of allowed origins. Example:
# CORS_ORIGINS=https://fleetflow.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Redis & Celery (Optional: For distributed caching, pub/sub, and recurring jobs)
# Local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Outbound Email Service (HTTP APIs - recommended for cloud hosts like Render)
RESEND_API_KEY=
RESEND_FROM=FleetFlow <onboarding@resend.dev>
BREVO_API_KEY=

# Outbound SMTP Email (Alternative for local or dedicated VPS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@fleetflow.com
EMAILS_FROM_NAME=FleetFlow Admin
