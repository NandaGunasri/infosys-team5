# ==============================================================================
# FleetFlow Frontend Environment Variables (Production & Local Template)
# ==============================================================================

# Backend API Base URL
# Local Development: http://127.0.0.1:8000
# Production on Vercel: Set to your live Render backend URL
# Example: https://fleetflow-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# Live WebSocket Streaming URL (Optional: automatically derived from API URL if omitted)
# Example: wss://fleetflow-backend.onrender.com
# VITE_WS_URL=ws://127.0.0.1:8000
