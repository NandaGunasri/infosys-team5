.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
*.pem
*.key
*.cert

# Python & Virtual Environments
venv/
backend/venv/
env/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
celerybeat-schedule*

# Node.js & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & SQLite files
*.sqlite
*.sqlite3
*.db

# Operating System & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Antigravity & Agent Scratch Directories
.gemini/
.system_generated/
scratch/
